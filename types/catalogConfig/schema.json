{
  "$id": "https://github.com/data-fair/catalog-sftp/catalog-config",
  "x-exports": ["types", "validate", "schema"],
  "title": "SFTPConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["url", "port", "connectionKey", "login"],
  "properties": {
    "url": {
      "type": "string",
      "title": "Host Address",
      "x-i18n-title": {
        "fr": "Adresse de l'hôte"
      },
      "description": "The host address",
      "x-i18n-description": {
        "fr": "L'adresse de l'hôte du catalogue (veuillez vous référer à la documentation technique du catalogue)"
      },
      "examples": ["exemple-d-hote.fr"]
    },
    "port": {
      "type": "integer",
      "title": "Port",
      "description": "The catalog API port",
      "x-i18n-description": {
        "fr": "Le port de l'API du catalogue (veuillez vous référez à la documentation technique du catalogue)"
      },
      "default": 22
    },
    "login": {
      "type": "string",
      "title": "Login / Username",
      "x-i18n-title": {
        "fr": "Identifiant / Nom d'utilisateur"
      },
      "description": "The login or username used to access the catalog",
      "x-i18n-description": {
        "fr": "L'identifiant (login ou nom d'utilisateur) utilisé pour accéder au catalogue"
      }
    },
    "connectionKey": {
      "type": "object",
      "title": "Connection Mode",
      "x-i18n-title": {
        "fr": "Mode de connexion"
      },
      "description": "The connection mode to use (password or SSH key)",
      "x-i18n-description": {
        "fr": "Le mode de connexion à utiliser (mot de passe ou clé SSH)"
      },
      "oneOfLayout": {
        "label": "Choose a connection mode",
        "x-i18n-label": {
          "fr": "Choisir un mode de connexion"
        }
      },
      "oneOf": [
        {
          "title": "Password",
          "x-i18n-title": {
            "fr": "Mot de passe"
          },
          "required": ["password"],
          "properties": {
            "key": { "const": "password" },
            "password": {
              "title": "Password",
              "x-i18n-title": {
                "fr": "Mot de passe"
              },
              "type": "string",
              "description": "Enter your account password for the remote server",
              "x-i18n-description": {
                "fr": "Renseignez le mot de passe associé à votre compte sur le serveur distant"
              },
              "layout": {
                "props": {
                  "type": "password",
                  "autocomplete": "suppress"
                }
              }
            }
          }
        },
        {
          "title": "SSH Key",
          "x-i18n-title": {
            "fr": "Clé SSH"
          },
          "required": ["sshKey"],
          "properties": {
            "key": { "const": "sshKey" },
            "sshKey": {
              "type": "string",
              "title": "SSH Private Key",
              "x-i18n-title": {
                "fr": "Clé SSH privée"
              },
              "layout": "textarea",
              "description": "Enter your SSH private key",
              "x-i18n-description": {
                "fr": "Renseignez votre clé SSH privée"
              }
            }
          }
        }
      ]
    }
  }
}
